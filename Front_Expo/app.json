{
  "expo": {
    "name": "Golazo Gift",
    "slug": "Golazo-gift-us",
    "version": "2.0.0",
    "scheme": [
      "golazo-gift-us",
      "com.googleusercontent.apps.520508328364-371ttf20f36iumci7k0q2lht6om5g0u3"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFF0F2"
    },
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "com.zelon.golazo.gift.us",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.520508328364-371ttf20f36iumci7k0q2lht6om5g0u3"
            ]
          }
        ]
      }
    },
    "android": {
      "versionCode": 2,
      "package": "com.zelon.golazo.gift.us",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF0F2"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "zelon",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37d85d5f-c026-4265-9a18-910a1c0a8449"
      }
    }
  }
}