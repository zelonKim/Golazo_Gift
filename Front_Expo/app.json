{
  "expo": {
    "name": "Golazo Gift",
    "slug": "Golazo-gift-us",
    "scheme": [
      "golazo-gift-us"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFF0F2"
    },
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.zelon.golazo.gift.us",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.98991306295-lovlqprpttnq8j8cnmubtqjmgtofr1o"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.zelon.golazo.gift.us",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF0F2"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useModularHeaders": true,
            "useFrameworks": "dynamic"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "zelon",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37d85d5f-c026-4265-9a18-910a1c0a8449"
      }
    }
  }
}
